# App
NEXT_PUBLIC_APP_URL=http://localhost:3123
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3123
DATABASE_URL="mysql://hmw:hmwpass@127.0.0.1:3308/hmw"
DATABASE_POOL_SIZE=5

# Admin allowlist. Accounts with these emails become ADMIN on sign-in.
ADMIN_EMAILS="admin@example.com"

# Local development only. Never enable these in production.
ALLOW_DEV_ADMIN=0
ALLOW_DEV_LOGIN=0
ALLOW_DEV_PAYMENTS=0
ALLOW_DEV_EMAIL=0
ALLOW_DEV_VERIFICATION=0
DEMO_MODE=0
DEV_ADMIN_SECRET=replace-with-random-dev-secret
DEV_ADMIN_SECURE=0
COOKIE_SECURE=0

# Email (Auth.js magic links and delivery codes)
RESEND_API_KEY=
EMAIL_FROM="hackmywebsite.ai <no-reply@hackmywebsite.ai>"
CRON_SECRET=replace-with-long-random

# Stripe. Leave blank to use the local dev payment provider.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Report delivery and worker secrets
DELIVERY_CODE_PEPPER=replace-with-long-random
DEV_DELIVERY_CODE=
REPORT_STORAGE_DIR=
WORKER_TOKEN_PEPPER=replace-with-long-random
WORKER_TOKEN=

# Scanner adapter. Local mock is for the preview only.
SCAN_ENGINE=mock
SCAN_PORTAL_URL=http://127.0.0.1:7777

# Object storage for encrypted final bundles (optional for local dev)
SPACES_ENDPOINT=
SPACES_REGION=
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=
