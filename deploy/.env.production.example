# Domain and database
DOMAIN=app.example.com
MARIADB_ROOT_PASSWORD=replace-with-long-random
MARIADB_DATABASE=hmw
MARIADB_USER=hmw
MARIADB_PASSWORD=replace-with-long-random
DATABASE_URL=mysql://hmw:replace-with-long-random@db:3306/hmw

# App
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=https://app.example.com
NEXT_PUBLIC_APP_URL=https://app.example.com
ADMIN_EMAILS=you@example.com

# Local/demo flags must all be off in production
ALLOW_DEV_LOGIN=0
ALLOW_DEV_ADMIN=0
ALLOW_DEV_PAYMENTS=0
ALLOW_DEV_EMAIL=0
ALLOW_DEV_VERIFICATION=0
DEMO_MODE=0

# Email
RESEND_API_KEY=
EMAIL_FROM="hackmywebsite.ai <no-reply@hackmywebsite.ai>"
CRON_SECRET=replace-with-long-random

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Worker and report delivery
WORKER_TOKEN=replace-with-long-random
WORKER_TOKEN_PEPPER=replace-with-long-random
DELIVERY_CODE_PEPPER=replace-with-long-random
REPORT_STORAGE_DIR=/app/data/reports

# Storage, if S3-compatible object storage is added later
SPACES_ENDPOINT=
SPACES_REGION=
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=
